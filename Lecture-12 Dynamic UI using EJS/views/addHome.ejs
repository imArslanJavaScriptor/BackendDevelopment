<!DOCTYPE html>
<html lang="en">

  <%- include('partials/head')%>

<body class="bg-gray-50 min-h-screen">

  <!-- Navbar -->
  <%- include('partials/header')%>


  <div class="max-w-2xl mx-auto px-6 py-12">
    <!-- Header -->
    <div class="mb-10 text-center">
      <h1 class="text-4xl font-semibold text-gray-900">Register your home</h1>
      <p class="text-gray-600 mt-3 text-lg">
        Tell us about your place so guests can find it easily
      </p>
    </div>

    <!-- Form -->
    <form action="/host/add-home" method="POST" class="bg-white rounded-3xl shadow-sm border border-gray-100 p-10">

      <div class="space-y-8">
        
        <!-- House Name -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">
            What is the name of your home?
          </label>
          <input 
            type="text" 
            name="houseName" 
            placeholder="e.g. Cozy Villa in the Hills"
            required
            class="w-full px-5 py-4 border border-gray-300 rounded-2xl focus:outline-none focus:border-[#FF5A5F] focus:ring-1 focus:ring-[#FF5A5F] text-lg placeholder-gray-400 transition"
          >
        </div>
        
        <!-- Price Per Night -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">
            What is the price per night?
          </label>
          <input 
            type="text" 
            name="price" 
            placeholder="e.g. 1000"
            required
            class="w-full px-5 py-4 border border-gray-300 rounded-2xl focus:outline-none focus:border-[#FF5A5F] focus:ring-1 focus:ring-[#FF5A5F] text-lg placeholder-gray-400 transition"
          >
        </div>

        <!-- Location -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">
            Your house location?
          </label>
          <input 
            type="text" 
            name="location" 
            placeholder="e.g. Lahore"
            required
            class="w-full px-5 py-4 border border-gray-300 rounded-2xl focus:outline-none focus:border-[#FF5A5F] focus:ring-1 focus:ring-[#FF5A5F] text-lg placeholder-gray-400 transition"
          >
        </div>

        <!-- Rating -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">
            how much your rate out of 10
          </label>
          <input 
            type="text" 
            name="rating" 
            placeholder="e.g. 8.5"
            required
            class="w-full px-5 py-4 border border-gray-300 rounded-2xl focus:outline-none focus:border-[#FF5A5F] focus:ring-1 focus:ring-[#FF5A5F] text-lg placeholder-gray-400 transition"
          >
        </div>

        <!-- Rating -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">
            Image URL
          </label>
          <input 
            type="text" 
            name="image" 
            placeholder="e.g. https://example.com/image.jpg"
            required
            class="w-full px-5 py-4 border border-gray-300 rounded-2xl focus:outline-none focus:border-[#FF5A5F] focus:ring-1 focus:ring-[#FF5A5F] text-lg placeholder-gray-400 transition"
          >
        </div>

        <!-- You can easily add more fields later -->
        <!-- Example: Location, Price, Description, etc. -->

        <!-- Submit Button -->
        <button 
          type="submit"
          class="w-full bg-[#FF5A5F] hover:bg-[#FF4248] text-white font-semibold text-lg py-4 rounded-2xl transition-all duration-200 shadow-md hover:shadow-lg mt-6">
          Add My Home
        </button>
      </div>

    </form>

    <!-- Help Text -->
    <p class="text-center text-sm text-gray-500 mt-8">
      Your home will be reviewed before going live. 
      <span class="text-[#FF5A5F] hover:underline cursor-pointer">Learn more</span>
    </p>

  </div>

</body>
</html>