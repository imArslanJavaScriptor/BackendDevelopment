<!DOCTYPE html>
<html lang="en">
  <%- include('partials/head')%>
  
<body class="bg-gray-50 min-h-screen flex items-center justify-center">

  <div class="max-w-md mx-auto text-center px-6">
    
    <!-- Airbnb Logo Style Icon -->
    <div class="flex justify-center mb-8">
      <div class="w-16 h-16 bg-[#FF5A5F] rounded-2xl flex items-center justify-center shadow-lg">
        <span class="text-white text-4xl font-bold">A</span>
      </div>
    </div>

    <!-- 404 Number -->
    <h1 class="text-8xl font-bold text-gray-800 tracking-tighter mb-2">404</h1>
    
    <!-- Title -->
    <h2 class="text-3xl font-semibold text-gray-900 mb-3">
      Page not found
    </h2>
    
    <!-- Description -->
    <p class="text-gray-600 text-lg mb-10">
      Sorry, we couldn't find the page you're looking for. 
      It might have been removed or the link is incorrect.
    </p>

    <!-- Action Buttons -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/" 
         class="bg-[#FF5A5F] hover:bg-[#FF4248] text-white font-medium px-8 py-4 rounded-2xl transition-all duration-200 shadow-md hover:shadow-lg flex items-center justify-center gap-2">
        <span>Go back home</span>
      </a>
      
      <a href="/help" 
         class="border border-gray-300 hover:border-gray-400 font-medium px-8 py-4 rounded-2xl transition-all duration-200 text-gray-700 hover:text-gray-900">
        Contact support
      </a>
    </div>

    <!-- Optional: Popular destinations hint -->
    <div class="mt-12 text-sm text-gray-500">
      Looking for a place to stay? 
      <a href="/s" class="text-[#FF5A5F] hover:underline font-medium">Browse homes →</a>
    </div>

  </div>

</body>
</html>