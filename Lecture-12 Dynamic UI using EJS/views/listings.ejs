<!DOCTYPE html>
<html lang="en">

  <%- include('partials/head')%>

<body class="bg-gray-50 min-h-screen">

  <!-- Navbar -->
  <nav class="bg-white border-b sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-6 py-5 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 bg-[#FF5A5F] rounded-2xl flex items-center justify-center">
          <span class="text-white text-3xl font-bold leading-none">A</span>
        </div>
        <span class="text-2xl font-semibold text-gray-900">airbnb</span>
      </div>

      <div class="hidden md:flex items-center gap-8 text-sm font-medium text-gray-700">
        <a href="/"
          class="px-6 py-3 text-sm font-semibold text-gray-700 hover:bg-gray-100 rounded-2xl transition">Home</a>
        <a href="/host/add-home"
          class="px-6 py-3 text-sm font-semibold text-gray-700 hover:bg-gray-100 rounded-2xl transition">Add Home</a>
        <a href="/host/my-listings"
          class="px-6 py-3 text-sm font-semibold text-gray-700 hover:bg-gray-100 rounded-2xl transition">Homes
          Listing</a>
      </div>
    </div>
  </nav>

  <!-- Listing Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-24">
  <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 leading-tight mb-4 text-center">
    Check out our registered homes
  </h2>

<ul class="grid grid-cols-1 gap-8 max-w-[400px] mx-auto p-6">
  <% registeredHomes.forEach(home => { %>
    <li class="group">
      <div class="bg-white border border-gray-100 rounded-2xl shadow-sm hover:shadow-2xl transition-all duration-500 overflow-hidden hover:-translate-y-2 p-8 relative">
        <div class="absolute top-0 left-0 w-full">
          <img src="<%= home.image %>" alt="<%= home.houseName %>" class="w-full h-full object-cover" />
        </div>
        
        <div class="flex justify-between items-start mb-2">
          <h3 class="text-xl font-bold text-gray-800 group-hover:text-blue-600 transition-colors">
            <%= home.houseName %>
          </h3>
          <span class="flex items-center gap-1 bg-yellow-100 text-yellow-700 px-2 py-1 rounded-lg text-xs font-bold">
            ⭐ <%= home.rating %>
          </span>
        </div>

        <div class="flex items-center gap-1 text-gray-500 text-sm mb-4">
          <%= home.location %>
        </div>

        <div class="border-t border-gray-50"></div>

        <div class="flex items-center justify-between mt-6">
          <div>
            <p class="text-xs text-gray-400 uppercase tracking-wider font-semibold">Price</p>
            <p class="text-2xl font-black text-gray-900">
              $<%= home.price %><span class="text-sm font-normal text-gray-500">/Night</span>
            </p>
          </div>
          
          <button class="bg-[#FF5A5F] text-white px-6 py-3 rounded-2xl text-sm font-medium hover:bg-[#FF4248] transition-colors shadow-lg shadow-gray-200">
            View Details
          </button>
        </div>

      </div>
    </li>
  <% }) %>
</ul>

  <!-- Empty State (Optional) -->
  <% if (registeredHomes.length === 0) { %>
    <div class="text-center py-8">
      <p class="text-gray-500 text-lg">No Home Registered Yet</p>
    </div>
  <% } %>
</section>

</body>

</html>